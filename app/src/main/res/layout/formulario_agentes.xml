<?xml version="1.0" encoding="utf-8"?>
<!-- Plantilla del formulario; se reutiliza para agregar y editar registros. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView
            android:id="@+id/txtTituloFormulario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Agregar registro"
            android:textColor="#212121"
            android:textSize="22sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/txtIdFormulario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="ID: se genera al guardar"
            android:textColor="#222222"
            android:textSize="18sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Nombre"
            android:labelFor="@id/nombre"
            android:textColor="#212121"
            android:textSize="16sp" />
        <EditText
            android:id="@+id/nombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:inputType="text"
            android:hint="Nombre"
            android:backgroundTint="#212121"
            android:textColor="#222222"
            android:textColorHint="#64748B"
            />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="RUT"
            android:labelFor="@id/rut"
            android:textColor="#212121"
            android:textSize="16sp" />
        <EditText
            android:id="@+id/rut"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:inputType="text"
            android:hint="RUT"
            android:backgroundTint="#212121"
            android:textColor="#222222"
            android:textColorHint="#64748B"
            />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Teléfono"
            android:labelFor="@id/telefono"
            android:textColor="#212121"
            android:textSize="16sp" />
        <EditText
            android:id="@+id/telefono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:inputType="phone"
            android:hint="Teléfono"
            android:backgroundTint="#212121"
            android:textColor="#222222"
            android:textColorHint="#64748B"
            />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Correo"
            android:labelFor="@id/correo"
            android:textColor="#212121"
            android:textSize="16sp" />
        <EditText
            android:id="@+id/correo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:inputType="textEmailAddress"
            android:hint="Correo"
            android:backgroundTint="#212121"
            android:textColor="#222222"
            android:textColorHint="#64748B"
            />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Comisión (%)"
            android:labelFor="@id/comision"
            android:textColor="#212121"
            android:textSize="16sp" />
        <EditText
            android:id="@+id/comision"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:inputType="numberDecimal"
            android:hint="Comisión (%)"
            android:backgroundTint="#212121"
            android:textColor="#222222"
            android:textColorHint="#64748B"
            />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Estado"
            android:labelFor="@id/estado"
            android:textColor="#212121"
            android:textSize="16sp" />
        <Spinner
            android:id="@+id/estado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:entries="@array/estados_agente"
            />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="end">
            <Button
                android:id="@+id/btnCancelar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#64748B"
                android:textColor="#FFFFFF"
                android:text="Cancelar" />
            <Button
                android:id="@+id/btnGuardar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:backgroundTint="#212121"
                android:textColor="#FFFFFF"
                android:text="Guardar" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
