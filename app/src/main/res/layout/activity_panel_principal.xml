<?xml version="1.0" encoding="utf-8"?>
<!-- Plantilla del diseño de esta pantalla; la actividad Kotlin la carga y controla sus botones. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#303F60"
        android:padding="24dp"
        android:text="Agencia de bienes raíces"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="Selecciona un mantenedor"
                android:textColor="#333333"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:layout_marginEnd="12dp"
                    android:background="#FFFFFF"
                    android:padding="4dp"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no"
                    android:src="@drawable/propiedades" />
            <Button
                android:id="@+id/btn_propiedades"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content"
                android:minHeight="80dp"
                android:backgroundTint="#216E42"
                android:text="Propiedades"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:layout_marginEnd="12dp"
                    android:background="#FFFFFF"
                    android:padding="4dp"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no"
                    android:src="@drawable/clientes" />
            <Button
                android:id="@+id/btn_clientes"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content"
                
                android:minHeight="80dp"
                android:backgroundTint="#185AA8"
                android:text="Clientes / compradores"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:layout_marginEnd="12dp"
                    android:background="#FFFFFF"
                    android:padding="4dp"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no"
                    android:src="@drawable/agentes" />
            <Button
                android:id="@+id/btn_agentes"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content"
                
                android:minHeight="80dp"
                android:backgroundTint="#212121"
                android:text="Agentes inmobiliarios"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_volver"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:backgroundTint="#303F60"
                android:text="Cerrar sesión"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>

